# Template for .env: npm run dev copies it to .env when .env is missing. Read by the Node platform.
# On Cloudflare the same keys live in api/platforms/cloudflare/wrangler.jsonc "vars".
# Every key is validated at startup by api/src/config.js.

# Port of the Node API server (optional, default 8787)
PORT=8787

# Browser origins allowed to call the API, comma-separated.
#   *.  at the start of the host = exactly one subdomain label (preview deployments)
#   :*  = any port, or none
ALLOWED_ORIGINS=https://elite-engineering.pages.dev,https://*.elite-engineering.pages.dev,http://localhost:*,http://127.0.0.1:*

# How long a downloaded feed is reused, and the Cache-Control max-age sent to browsers
FEED_CACHE_SECONDS=1800

# Requests allowed per client IP in each period
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD_SECONDS=60

# pino level: trace, debug, info, warn, error, fatal (optional, default info)
LOG_LEVEL=info
