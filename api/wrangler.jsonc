{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elite-engineering-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "ratelimits": [
    {
      // 60 requests per minute per IP; a full page load without cache makes 15
      "name": "FEED_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
